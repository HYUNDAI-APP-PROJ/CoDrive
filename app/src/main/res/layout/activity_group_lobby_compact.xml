<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/group_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/group_background" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:paddingStart="24dp" android:paddingEnd="24dp">
        <TextView style="@style/Group.Text" android:layout_width="0dp" android:layout_weight="1" android:text="@string/group_brand" android:textSize="24sp" android:textStyle="bold"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/theme" style="@style/Group.Button" android:text="@string/group_theme" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:background="@drawable/group_hero">
                <TextView  style="@style/Group.Text" android:text="@string/group_hero_label" android:textSize="14sp" android:textColor="@color/group_hero_muted"/>
                <TextView  style="@style/Group.Text" android:text="@string/group_tagline" android:textSize="32sp" android:textColor="#FFFDF8" android:textStyle="bold" android:layout_marginTop="24dp"/>
                <TextView  style="@style/Group.Text" android:text="@string/group_intro" android:textSize="16sp" android:textColor="@color/group_hero_muted" android:layout_marginTop="20dp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:layout_marginTop="12dp" android:background="@drawable/group_card">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" >
                    <TextView android:id="@+id/form_title" style="@style/Group.Text" android:text="@string/group_create_title" android:textSize="24sp" android:textStyle="bold"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
                        <com.google.android.material.button.MaterialButton android:id="@+id/create_tab" style="@style/Group.Button" android:text="@string/group_create" android:layout_width="0dp" android:layout_weight="1"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/join_tab" style="@style/Group.Button" android:text="@string/group_join" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="8dp"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/name_field">
                        <TextView style="@style/Group.Label" android:text="@string/group_name" android:labelFor="@id/group_name"/>
                        <EditText android:id="@+id/group_name" style="@style/Group.Input" android:hint="@string/group_name_hint" android:inputType="textCapSentences" android:maxLength="30" android:saveEnabled="false"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/code_field" android:visibility="gone">
                        <TextView style="@style/Group.Label" android:text="@string/group_invite" android:labelFor="@id/invite_code"/>
                        <EditText android:id="@+id/invite_code" style="@style/Group.Input" android:hint="@string/group_code_hint" android:inputType="textCapCharacters" android:maxLength="6" android:saveEnabled="false"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
                            <TextView style="@style/Group.Label" android:text="@string/group_alias" android:labelFor="@id/vehicle_alias"/>
                            <EditText android:id="@+id/vehicle_alias" style="@style/Group.Input" android:hint="@string/group_alias_hint" android:inputType="textCapSentences" android:maxLength="20" android:saveEnabled="false"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="0.6" android:layout_marginStart="12dp">
                            <TextView style="@style/Group.Label" android:text="@string/group_passengers" android:labelFor="@id/passengers"/>
                            <EditText android:id="@+id/passengers" style="@style/Group.Input" android:hint="@string/group_passengers" android:inputType="number" android:maxLength="1" android:saveEnabled="false"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/rule_field">
                        <TextView  style="@style/Group.Text" android:text="@string/group_rule" android:textSize="14sp" android:layout_marginTop="8dp"/>
                        <RadioGroup android:id="@+id/decision_rule" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:checkedButton="@id/rule_majority">
                            <RadioButton android:id="@+id/rule_majority" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="@string/group_majority" android:textSize="16sp" android:textColor="@color/group_ink"/>
                            <RadioButton android:id="@+id/rule_leader" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="@string/group_leader_rule" android:textSize="16sp" android:textColor="@color/group_ink"/>
                        </RadioGroup>
                    </LinearLayout>
                    <TextView android:id="@+id/form_note" style="@style/Group.Text" android:text="@string/group_rule_note" android:textSize="14sp" android:textColor="@color/group_muted" android:layout_marginTop="8dp"/>
                    <TextView android:id="@+id/form_error" style="@style/Group.Text" android:textColor="@color/group_error" android:accessibilityLiveRegion="polite" android:visibility="gone"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/submit" style="@style/Group.Primary" android:text="@string/group_create" android:layout_width="match_parent" android:layout_marginTop="12dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>

<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:minHeight="@dimen/group_member_height" android:gravity="center_vertical" android:padding="16dp" android:background="@drawable/group_field">
    <ImageView android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/group_badge" android:padding="10dp" android:src="@drawable/group_ic_car" android:importantForAccessibility="no"/>
    <LinearLayout  android:layout_height="wrap_content" android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="12dp">
        <TextView android:id="@+id/member_alias" style="@style/Group.Text"  android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/member_detail" style="@style/Group.Text"  android:textSize="@dimen/group_small" android:textColor="@color/group_muted" android:layout_marginTop="6dp"/>
    </LinearLayout>
    <TextView android:id="@+id/member_status" style="@style/Group.Text"  android:layout_width="wrap_content" android:textSize="12sp" android:textColor="@color/group_muted" android:padding="8dp" android:background="@drawable/group_badge" android:layout_marginStart="8dp"/>
</LinearLayout>

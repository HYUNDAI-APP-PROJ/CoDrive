<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/convoy_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:baselineAligned="false" android:background="@color/convoy_background">
    <ScrollView android:id="@+id/convoy_sidebar" android:layout_width="220dp" android:layout_height="match_parent"
        android:background="@drawable/convoy_sidebar_background" android:scrollbars="none">
        <LinearLayout android:id="@+id/convoy_sidebar_content" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingHorizontal="16dp" android:paddingVertical="28dp" android:orientation="vertical">
            <TextView android:id="@+id/convoy_nav_brand" style="@style/ConvoyText" android:layout_width="match_parent"
                android:layout_height="48dp" android:layout_marginBottom="24dp" android:gravity="center_vertical"
                android:paddingHorizontal="12dp" android:text="@string/convoy_brand" android:contentDescription="@string/convoy_brand"
                android:textColor="@color/convoy_background" android:textSize="26sp" android:textStyle="bold" />
            <LinearLayout android:id="@+id/convoy_nav_group" style="@style/ConvoyNavItem" android:enabled="false">
                <ImageView style="@style/ConvoyNavIcon" android:src="@drawable/convoy_ic_group" />
                <TextView android:id="@+id/convoy_nav_label_group" style="@style/ConvoyNavLabel" android:text="@string/convoy_nav_group" />
            </LinearLayout>
            <LinearLayout android:id="@+id/convoy_nav_drive" style="@style/ConvoyNavItem" android:background="@drawable/convoy_nav_selected" android:contentDescription="@string/convoy_nav_current">
                <ImageView style="@style/ConvoyNavIcon" android:src="@drawable/convoy_ic_drive" android:tint="@color/convoy_ink" />
                <TextView android:id="@+id/convoy_nav_label_drive" style="@style/ConvoyNavLabel" android:text="@string/convoy_nav_drive" android:textColor="@color/convoy_ink" android:fontFamily="sans-serif-medium" />
            </LinearLayout>
            <LinearLayout android:id="@+id/convoy_nav_recommendation" style="@style/ConvoyNavItem" android:enabled="false">
                <ImageView style="@style/ConvoyNavIcon" android:src="@drawable/convoy_ic_route" />
                <TextView android:id="@+id/convoy_nav_label_recommendation" style="@style/ConvoyNavLabel" android:text="@string/convoy_nav_recommendation" />
            </LinearLayout>
            <LinearLayout android:id="@+id/convoy_nav_voice" style="@style/ConvoyNavItem" android:enabled="false">
                <ImageView style="@style/ConvoyNavIcon" android:src="@drawable/convoy_ic_mic" />
                <TextView android:id="@+id/convoy_nav_label_voice" style="@style/ConvoyNavLabel" android:text="@string/convoy_nav_voice" />
            </LinearLayout>
            <LinearLayout android:id="@+id/convoy_nav_history" style="@style/ConvoyNavItem" android:enabled="false">
                <ImageView style="@style/ConvoyNavIcon" android:src="@drawable/convoy_ic_history" />
                <TextView android:id="@+id/convoy_nav_label_history" style="@style/ConvoyNavLabel" android:text="@string/convoy_nav_history" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <FrameLayout android:id="@+id/convoy_main_host" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
        android:paddingStart="40dp" android:paddingEnd="40dp" android:paddingTop="28dp" android:paddingBottom="24dp">
        <LinearLayout android:id="@+id/convoy_content" android:layout_width="match_parent" android:layout_height="match_parent"
            android:layout_gravity="center_horizontal" android:orientation="vertical">
            <LinearLayout android:id="@+id/convoy_topbar" android:layout_width="match_parent" android:layout_height="64dp"
                android:gravity="center_vertical" android:baselineAligned="false">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="16dp" android:orientation="vertical">
                    <TextView android:id="@+id/convoy_page_title" style="@style/ConvoyText" android:text="@string/convoy_title" android:textSize="28sp" android:fontFamily="sans-serif-medium" />
                    <TextView android:id="@+id/convoy_members_summary" style="@style/ConvoyText.Muted" android:layout_width="match_parent"
                        android:layout_marginTop="6dp" android:maxLines="1" android:ellipsize="end" />
                </LinearLayout>
                <TextView android:id="@+id/convoy_demo" style="@style/ConvoyText" android:text="@string/convoy_demo"
                    android:layout_height="64dp" android:gravity="center" android:paddingHorizontal="20dp" android:textSize="18sp"
                    android:stateListAnimator="@animator/convoy_button_press" />
            </LinearLayout>
            <LinearLayout android:id="@+id/convoy_destination_panel" android:layout_width="match_parent" android:layout_height="300dp"
                android:layout_marginTop="8dp" android:padding="16dp" android:orientation="vertical" android:background="@drawable/convoy_destination_panel">
                <LinearLayout android:id="@+id/convoy_header" android:layout_width="match_parent" android:layout_height="76dp" android:gravity="center_vertical" android:baselineAligned="false">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="16dp">
                        <TextView android:id="@+id/convoy_destination" style="@style/ConvoyText" android:textSize="36sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
                        <TextView android:id="@+id/convoy_destination_summary" style="@style/ConvoyText.Muted" android:layout_marginTop="4dp" android:maxLines="1" android:ellipsize="end" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
                        <TextView android:id="@+id/convoy_arrival_summary" style="@style/ConvoyText" android:textSize="28sp" android:textStyle="bold" />
                        <TextView android:id="@+id/convoy_comparison_scope" style="@style/ConvoyText.Muted" android:layout_marginTop="4dp" />
                    </LinearLayout>
                </LinearLayout>
                <com.codrive.convoy.ui.RemainingDistanceTrack android:id="@+id/convoy_track"
                    android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:importantForAccessibility="yes" />
            </LinearLayout>
            <LinearLayout android:id="@+id/convoy_cards" android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:layout_marginTop="12dp" android:orientation="horizontal" android:baselineAligned="false" />
            <TextView android:id="@+id/convoy_alert" style="@style/ConvoyText.Muted" android:layout_width="match_parent"
                android:layout_height="40dp" android:gravity="center_vertical" android:drawableStart="@drawable/convoy_ic_alert" android:drawablePadding="8dp" android:accessibilityLiveRegion="polite" android:maxLines="2" />
            <LinearLayout android:id="@+id/convoy_actions" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="12dp" android:baselineAligned="false">
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/convoy_rest" style="@style/ConvoyAction" android:text="@string/convoy_rest" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/convoy_energy" style="@style/ConvoyAction" android:layout_marginStart="12dp" android:text="@string/convoy_energy" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/convoy_mic" style="@style/ConvoyAction" android:layout_width="64dp" android:layout_weight="0" android:padding="20dp" android:layout_marginStart="12dp" android:text="@string/convoy_mic" android:visibility="gone" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/convoy_voice" style="@style/ConvoyAction" android:layout_marginStart="12dp" android:text="@string/convoy_voice" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>

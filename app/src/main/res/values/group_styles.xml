<resources>
<style name="Theme.CoDrive.Group" parent="Theme.MaterialComponents.DayNight.NoActionBar">
<item name="colorPrimary">@color/group_ink</item><item name="colorOnPrimary">@color/group_on_accent</item>
<item name="colorSecondary">@color/group_ink</item><item name="android:colorAccent">@color/group_ink</item>
<item name="android:windowBackground">@color/group_background</item><item name="android:fontFamily">sans</item>
<item name="android:colorError">@color/group_error</item>
</style>
<style name="Group.Text" parent=""><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:textColor">@color/group_ink</item><item name="android:textSize">@dimen/group_body</item></style>
<style name="Group.Label" parent="Group.Text"><item name="android:textSize">14sp</item><item name="android:layout_marginTop">6dp</item></style>
<style name="Group.Input" parent="">
<item name="android:layout_width">match_parent</item><item name="android:layout_height">@dimen/group_control</item>
<item name="android:background">@drawable/group_field</item><item name="android:paddingStart">12dp</item><item name="android:paddingEnd">12dp</item>
<item name="android:textColor">@color/group_ink</item><item name="android:textColorHint">@color/group_muted</item>
<item name="android:textSize">@dimen/group_body</item><item name="android:singleLine">true</item><item name="android:imeOptions">actionNext</item>
</style>
<style name="Group.Button" parent="Widget.MaterialComponents.Button.OutlinedButton">
<item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item>
<item name="android:minHeight">@dimen/group_control</item><item name="android:minWidth">48dp</item>
<item name="android:textSize">@dimen/group_body</item><item name="android:textAllCaps">false</item>
<item name="android:textColor">@color/group_button_text</item><item name="strokeColor">@color/group_line</item>
<item name="cornerRadius">10dp</item><item name="android:insetTop">0dp</item><item name="android:insetBottom">0dp</item>
</style>
<style name="Group.Primary" parent="Group.Button">
<item name="backgroundTint">@color/group_button_fill</item><item name="android:textColor">@color/group_on_accent</item><item name="strokeWidth">0dp</item>
</style>
</resources>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/group_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/group_background" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent"  android:orientation="horizontal" android:baselineAligned="false" android:layout_height="@dimen/group_header" android:gravity="center_vertical" android:paddingStart="@dimen/group_hero_padding" android:paddingEnd="@dimen/group_hero_padding">
        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/group_hero" android:padding="10dp" android:src="@drawable/group_ic_car" app:tint="#FFFFFF" android:importantForAccessibility="no"/>
        <TextView  style="@style/Group.Text" android:text="@string/group_brand" android:layout_width="0dp" android:layout_weight="1" android:textSize="28sp" android:textStyle="bold" android:layout_marginStart="12dp"/>
        <TextView android:id="@+id/header_context" style="@style/Group.Text" android:text="@string/group_context" android:layout_width="wrap_content" android:textColor="@color/group_muted" android:textSize="@dimen/group_small" android:layout_marginEnd="16dp"/>
        <ImageButton android:id="@+id/theme" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/group_card" android:padding="12dp" android:src="@drawable/group_ic_moon" android:contentDescription="@string/group_switch_night"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent"  android:orientation="horizontal" android:baselineAligned="false" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/group_shell" android:clipToOutline="true" android:layout_marginStart="@dimen/group_outer" android:layout_marginEnd="@dimen/group_outer" android:layout_marginBottom="@dimen/group_outer">
        <FrameLayout android:layout_width="0dp" android:layout_weight="0.41" android:layout_height="match_parent" android:background="@color/group_hero">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/group_hero_decor" android:scaleType="fitXY" android:importantForAccessibility="no"/>
            <LinearLayout android:layout_width="match_parent"  android:orientation="vertical" android:layout_height="match_parent" android:padding="@dimen/group_hero_padding">
                <TextView  style="@style/Group.Text" android:text="@string/group_hero_label" android:textSize="@dimen/group_small" android:textColor="@color/group_hero_muted" android:textStyle="bold"/>
                <TextView  style="@style/Group.Text" android:text="@string/group_tagline" android:textSize="@dimen/group_hero_title" android:textStyle="bold" android:textColor="#FFFFFF" android:layout_marginTop="@dimen/group_hero_gap"/>
                <TextView  style="@style/Group.Text" android:text="@string/group_intro" android:textColor="@color/group_hero_muted" android:lineSpacingExtra="6dp" android:layout_marginTop="24dp"/>
                <ImageView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="100dp" android:src="@drawable/group_road" android:scaleType="fitCenter" android:importantForAccessibility="no"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" >
                    <TextView  style="@style/Group.Text" android:text="@string/group_pill_cars" android:layout_width="wrap_content" android:textSize="12sp" android:textColor="#D7D8DC" android:background="@drawable/group_pill" android:padding="10dp" android:layout_marginEnd="8dp"/>
                    <TextView  style="@style/Group.Text" android:text="@string/group_pill_ready" android:layout_width="wrap_content" android:textSize="12sp" android:textColor="#D7D8DC" android:background="@drawable/group_pill" android:padding="10dp" android:layout_marginEnd="8dp"/>
                    <TextView  style="@style/Group.Text" android:text="@string/group_pill_trip" android:layout_width="wrap_content" android:textSize="12sp" android:textColor="#D7D8DC" android:background="@drawable/group_pill" android:padding="10dp" android:layout_marginEnd="8dp"/>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
        <ScrollView android:layout_width="0dp" android:layout_weight="0.59" android:layout_height="match_parent" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent"  android:orientation="vertical" android:layout_height="match_parent" android:padding="@dimen/group_panel_padding">
                <TextView  style="@style/Group.Text" android:text="@string/group_breadcrumb" android:textSize="@dimen/group_small" android:textColor="@color/group_muted"/>
                <TextView android:id="@+id/form_title" style="@style/Group.Text" android:text="@string/group_create_title" android:textSize="@dimen/group_title" android:textStyle="bold" android:layout_marginTop="@dimen/group_block_gap"/>
                <TextView android:id="@+id/form_subtitle" style="@style/Group.Text" android:text="@string/group_create_subtitle" android:textColor="@color/group_muted" android:layout_marginTop="8dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:background="@drawable/group_field" android:padding="5dp" android:layout_marginTop="@dimen/group_block_gap" android:layout_marginBottom="@dimen/group_block_gap">
                    <TextView android:id="@+id/create_tab" android:layout_width="0dp" android:layout_weight="1" android:layout_height="@dimen/group_control" android:gravity="center" android:text="@string/group_create" android:textColor="@color/group_ink" android:textSize="@dimen/group_small" android:textStyle="bold" android:background="@drawable/group_tab" android:clickable="true" android:focusable="true"/>
                    <TextView android:id="@+id/join_tab" android:layout_width="0dp" android:layout_weight="1" android:layout_height="@dimen/group_control" android:gravity="center" android:text="@string/group_join" android:textColor="@color/group_ink" android:textSize="@dimen/group_small" android:textStyle="bold" android:background="@drawable/group_tab" android:clickable="true" android:focusable="true"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/name_field">
                    <TextView  style="@style/Group.Text" android:text="@string/group_name" android:textSize="@dimen/group_small" android:textStyle="bold" android:labelFor="@id/group_name" android:layout_marginBottom="6dp"/>
                    <EditText android:id="@+id/group_name" style="@style/Group.Input" android:hint="@string/group_name_hint" android:inputType="textCapSentences" android:maxLength="30" android:saveEnabled="false" android:importantForAutofill="no" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/code_field" android:visibility="gone">
                    <TextView  style="@style/Group.Text" android:text="@string/group_invite" android:textSize="@dimen/group_small" android:textStyle="bold" android:labelFor="@id/invite_code" android:layout_marginBottom="6dp"/>
                    <EditText android:id="@+id/invite_code" style="@style/Group.Input" android:hint="@string/group_code_hint" android:inputType="textCapCharacters" android:maxLength="6" android:saveEnabled="false" android:importantForAutofill="no" android:textSize="26sp" android:letterSpacing="0.25"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:layout_marginTop="@dimen/group_label_gap">
                    <LinearLayout  android:layout_height="wrap_content" android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1.35">
                        <TextView  style="@style/Group.Text" android:text="@string/group_alias_optional" android:textSize="@dimen/group_small" android:textStyle="bold" android:labelFor="@id/vehicle_alias" android:layout_marginBottom="6dp"/>
                        <EditText android:id="@+id/vehicle_alias" style="@style/Group.Input" android:hint="@string/group_alias_hint" android:inputType="textCapSentences" android:maxLength="20" android:saveEnabled="false" android:importantForAutofill="no" />
                    </LinearLayout>
                    <LinearLayout  android:layout_height="wrap_content" android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="16dp">
                        <TextView  style="@style/Group.Text" android:text="@string/group_passengers" android:textSize="@dimen/group_small" android:textStyle="bold" android:labelFor="@id/passengers" android:layout_marginBottom="6dp"/>
                        <LinearLayout android:layout_width="match_parent"  android:orientation="horizontal" android:baselineAligned="false" android:layout_height="@dimen/group_control" android:background="@drawable/group_field" android:padding="4dp" android:gravity="center_vertical">
                            <com.google.android.material.button.MaterialButton android:id="@+id/passengers_minus" style="@style/Group.Button" android:text="@string/group_minus" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@string/group_count_down" app:backgroundTint="@color/group_surface" android:textColor="@color/group_ink"/>
                            <EditText android:id="@+id/passengers" style="@style/Group.Input" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="end|center_vertical" android:background="@android:color/transparent" android:padding="0dp" android:inputType="number" android:maxLength="1" android:focusable="false" android:cursorVisible="false" android:saveEnabled="false" android:contentDescription="@string/group_passengers"/>
                            <TextView  style="@style/Group.Text" android:text="@string/group_count_unit" android:layout_width="0dp" android:layout_weight="1" android:gravity="start|center_vertical"/>
                            <com.google.android.material.button.MaterialButton android:id="@+id/passengers_plus" style="@style/Group.Primary" android:text="@string/group_plus" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@string/group_count_up" app:backgroundTint="@color/group_surface" android:textColor="@color/group_ink"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/rule_field" android:layout_marginTop="@dimen/group_label_gap">
                    <TextView  style="@style/Group.Text" android:text="@string/group_rule_title" android:textSize="@dimen/group_small" android:textStyle="bold" android:labelFor="@id/decision_rule" android:layout_marginBottom="6dp"/>
                    <RadioGroup android:id="@+id/decision_rule" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:checkedButton="@id/rule_majority">
                        <RadioButton android:id="@+id/rule_majority" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="@dimen/group_control" android:layout_weight="1" android:padding="12dp" android:layout_marginStart="0dp" android:text="@string/group_majority_card" android:textSize="@dimen/group_small" android:textColor="@color/group_ink" android:background="@drawable/group_rule_card" android:buttonTint="@color/group_ink"/>
                        <RadioButton android:id="@+id/rule_leader" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="@dimen/group_control" android:layout_weight="1" android:padding="12dp" android:layout_marginStart="12dp" android:text="@string/group_leader_card" android:textSize="@dimen/group_small" android:textColor="@color/group_ink" android:background="@drawable/group_rule_card" android:buttonTint="@color/group_ink"/>
                    </RadioGroup>
                </LinearLayout>
                <TextView android:id="@+id/join_help" style="@style/Group.Text" android:text="@string/group_join_help" android:visibility="gone" android:textColor="@color/group_muted" android:textSize="@dimen/group_small" android:background="@drawable/group_field" android:padding="16dp" android:layout_marginTop="@dimen/group_label_gap"/>
                <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>
                <TextView android:id="@+id/form_note" style="@style/Group.Text" android:text="@string/group_rule_note" android:textSize="@dimen/group_small" android:textColor="@color/group_muted" android:layout_marginTop="16dp"/>
                <TextView android:id="@+id/form_error" style="@style/Group.Text"  android:textColor="@color/group_error" android:accessibilityLiveRegion="polite" android:visibility="gone"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/submit" style="@style/Group.Primary" android:text="@string/group_create" android:layout_width="match_parent" app:icon="@drawable/group_ic_arrow" app:iconGravity="textEnd" android:layout_marginTop="12dp"/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:padding="12dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/group_field" android:layout_marginTop="8dp">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/member_alias" style="@style/Group.Text" android:textStyle="bold" android:maxLines="2" android:ellipsize="end"/>
        <TextView android:id="@+id/member_detail" style="@style/Group.Text" android:textSize="14sp" android:textColor="@color/group_muted"/>
    </LinearLayout>
    <TextView android:id="@+id/member_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:textSize="14sp" android:textColor="@color/group_ink"/>
</LinearLayout>
